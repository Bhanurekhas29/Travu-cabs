# Copy this file to .env and fill in real values. Never commit the real .env file.

EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
BOOKING_NOTIFICATION_EMAIL=

# --- MySQL database (create this database in MySQL Workbench first) ---
DB_NAME=blueholidays
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_HOST=localhost
DB_PORT=3306

# --- Local development (default) ---
DEBUG=True
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# --- Render production values (set these in the Render dashboard's
#     Environment tab for the backend service, NOT in this file) ---
# DEBUG=False
# ALLOWED_HOSTS=travu.in,www.travu.in,<your-backend-service>.onrender.com
# CORS_ALLOWED_ORIGINS=https://travu.in,https://www.travu.in,https://<your-frontend-service>.onrender.com
